      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"ggaddak-app\", app=\"backend\", service=\"BE-ANALYSIS-RUNNER\"} |= \"analysis.failed\" [$__range]))",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
