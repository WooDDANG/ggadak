      "type": "piechart",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum by (stage) (count_over_time({job=\"ggaddak-ai\"}[$__range]))",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
