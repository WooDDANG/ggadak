      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "{job=\"ggaddak-app\"} |~ \"analysis[.](attempt[.]failed|validation[.]failed|failed)\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": { "showLabels": true, "wrapLogMessage": true, "enableLogDetails": true }
