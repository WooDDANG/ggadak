      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "{job=\"ggaddak-app\", level=\"ERROR\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": { "showLabels": true, "wrapLogMessage": true, "enableLogDetails": true }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
