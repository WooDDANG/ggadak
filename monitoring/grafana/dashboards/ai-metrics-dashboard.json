          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"ggaddak-ai\", stage=\"repair\"} | json | durationMs > 0 | model !~ \"fixture.*\" [$__range])) / sum(count_over_time({job=\"ggaddak-ai\", stage=\"extract\"} | json | durationMs > 0 | model !~ \"fixture.*\" [$__range])) * 100",
