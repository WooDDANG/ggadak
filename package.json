{
  "name": "ggaddak-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:bot": "npm run dev --workspace=@ggaddak/bot",
    "dev:be": "npm run dev --workspace=@ggaddak/be",
    "dev:fe": "npm run dev --workspace=@ggaddak/fe",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build && npm run test --workspaces --if-present && tsc -p tsconfig.test.json && node --test dist-test/e2e.test.js"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^22.0.0"
  }
}
