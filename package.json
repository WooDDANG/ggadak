{
  "name": "ggaddak-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "agents:codex": "codex --no-daemon",
    "agents:resume": "codex resume --no-daemon",
    "dev:prepare": "npm run build --workspace=@ggaddak/shared && npm run db:generate --workspace=@ggaddak/be && npm run db:upgrade -- --apply",
    "predev": "npm run dev:prepare",
    "predev:all": "npm run dev:prepare",
    "dev": "npm run build && concurrently -n \"BE,BOT,FE\" -c \"blue,green,magenta\" \"npm run dev:be\" \"npm run dev:bot\" \"npm run dev:fe\"",
    "dev:all": "npm run build && concurrently -n \"BE,BOT,FE\" -c \"blue,green,magenta\" \"npm run dev:be\" \"npm run dev:bot\" \"npm run dev:fe\"",
    "dev:bot": "npm run dev --workspace=@ggaddak/bot",
    "dev:be": "npm run dev --workspace=@ggaddak/be",
    "dev:fe": "npm run dev --workspace=@ggaddak/fe",
    "build": "npm run build --workspaces --if-present",
    "api:sync": "npm run swagger --workspace=@ggaddak/be && npm run codegen --workspace=@ggaddak/fe",
    "db:studio": "npm run db:studio --workspace=@ggaddak/be --",
    "db:check": "npm run db:check --workspace=@ggaddak/be --",
    "db:backup": "npm run db:backup --workspace=@ggaddak/be --",
    "db:upgrade": "npm run db:upgrade --workspace=@ggaddak/be --",
    "db:backfill": "npm run db:backfill --workspace=@ggaddak/be --",
    "db:audit": "npm run db:audit --workspace=@ggaddak/be --",
    "ai:benchmark": "npm run ai:benchmark --workspace=@ggaddak/be --",
    "test": "npm run build && npm run test --workspaces --if-present && npm run test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,html}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,html}\"",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "npm run typecheck --workspace=@ggaddak/be && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
