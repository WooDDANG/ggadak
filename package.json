{
  "name": "ggaddak-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:bot": "npm run dev --workspace=@ggaddak/bot",
    "dev:be": "npm run dev --workspace=@ggaddak/be",
    "dev:fe": "npm run dev --workspace=@ggaddak/fe",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.4.5"
  }
}
