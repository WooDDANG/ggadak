# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
TRIGGER_EMOJI=📌

# Backend Configuration
BE_PORT=3001
BE_DATABASE_PATH=./decisions.sqlite
BE_WEBHOOK_URL=http://localhost:3001/api/webhooks/decisions

# Frontend Configuration
FE_PORT=3002

# AI extraction: agy (cached CLI login), gemini, openai; mock is development/test only
NODE_ENV=development
AI_PROVIDER=agy
AI_MODEL=gemini-3.8-flash-low
# Optional stage overrides; unset stages use AI_MODEL. Use slugs from agy models.
# AI_MODEL_EXTRACT=gemini-3.8-flash-low
# AI_MODEL_VERIFY=claude-sonnet-5-5-low
# AI_MODEL_REPAIR=gemini-3.8-flash-medium
AGY_EXECUTABLE=agy
AI_MAX_OUTPUT_TOKENS=8192
# Gemini HTTP uses model metadata + countTokens. Not supported by agy CLI:
# AI_MAX_INPUT_TOKENS=1048576
# 0 disables the application character cap (model token cap still applies).
AI_MAX_INPUT_CHARS=0
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Durable bot analysis delivery journal; mount persistent storage in deployment
ANALYSIS_DELIVERY_DIR=./.data/analysis-deliveries
# Bot deadline covers the BE 180-second session budget.
ANALYSIS_TIMEOUT_MS=190000
# Durable receipt returns before AI; false keeps compatibility with the old synchronous BE.
ANALYSIS_ASYNC_DELIVERY=true
ANALYSIS_CONCURRENCY=1
ANALYSIS_FOREGROUND_BURST=5
ANALYSIS_QUEUE_MAX_BYTES=268435456
ANALYSIS_QUEUE_CHANNEL_BYTES=67108864
ANALYSIS_QUEUE_REQUEST_BYTES=262144
ANALYSIS_QUEUE_MAX_PENDING=2000
ANALYSIS_QUEUE_MIN_FREE_BYTES=67108864
BOT_JOURNAL_MAX_BYTES=268435456
BOT_SCAN_MAX_BYTES=67108864
ANALYSIS_COMPLETED_RETENTION_MS=604800000

# Discord user login (BE); register this exact FE callback in Discord OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3002/
# At least 32 random characters; shared across BE replicas, never sent to FE.
AUTH_SECRET=
# Optional FE build setting for a same-site BE origin; blank uses /api proxy.
VITE_API_ORIGIN=

# Shared secret for Bot internal monitoring reads (same value in BE and Bot)
BOT_SERVICE_TOKEN=

# Explicit frontend origins allowed to send credentialed browser requests
CORS_ORIGINS=http://localhost:5173,http://localhost:3002

# Why search uses real semantic embeddings independently of extraction provider.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY must be configured for both query and document embeddings.

# Browser links emitted by Discord commands
WEB_URL=http://localhost:3002
REVIEW_WEB_URL=http://localhost:3002
