# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Enable Server Members Intent in Discord Developer Portal before setting true.
DISCORD_GUILD_MEMBERS_INTENT=false
GUILD_ACCESS_DELIVERY_DIR=./.data/guild-access
TRIGGER_EMOJI=📌

# Backend Configuration
BE_PORT=3001
BE_DATABASE_PATH=./decisions.sqlite
BE_WEBHOOK_URL=http://localhost:3001/api/webhooks/decisions

# Frontend Configuration
FE_PORT=3002

# AI extraction: 'nvidia' (OpenAI SDK HTTP API) or 'agy' (cached CLI login); mock is development/test only
NODE_ENV=development
AI_PROVIDER=nvidia
AI_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA 계정 키: 번호 키가 있으면 기존 단일 키보다 우선한다. 서로 다른 계정의 키를 입력한다.
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
# 단일 키 설정도 지원한다. 비어 있는 번호 키와 중복 키는 제외한다.
NVIDIA_API_KEY=
# 계정별 분당 호출 예산. 현재 운영 기준이며 실제 계정 한도 이하로 지정한다.
NVIDIA_REQUESTS_PER_MINUTE=40
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ENABLE_THINKING=false
# JSON 모드를 지원하지 않는 NVIDIA 호환 엔드포인트에서는 false로 설정한다.
NVIDIA_JSON_MODE=true
# Verify 모델이 JSON Schema 출력을 지원하지 않으면 false로 설정한다.
NVIDIA_VERIFY_JSON_SCHEMA=true
AI_CALL_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=16384
# Optional stage overrides; unset stages use AI_MODEL.
# AI_MODEL_EXTRACT=nvidia/nemotron-3.5-super-vl-120b-a12b
# AI_MODEL_VERIFY=nvidia/nemotron-3.5-super-vl-120b-a12b
# AI_MODEL_REPAIR=nvidia/nemotron-3.5-super-vl-120b-a12b
# AGY Configuration (when AI_PROVIDER=agy)
AGY_EXECUTABLE=agy
AI_MAX_OUTPUT_TOKENS=8192
# Exact input-token preflight is not supported by the agy CLI:
# AI_MAX_INPUT_TOKENS=1048576
# 0 disables the application character cap (model token cap still applies).
AI_MAX_INPUT_CHARS=0
# Durable bot analysis delivery journal; mount persistent storage in deployment
ANALYSIS_DELIVERY_DIR=./.data/analysis-deliveries
# Bot deadline covers the BE 180-second session budget.
ANALYSIS_TIMEOUT_MS=190000
# Durable receipt returns before AI; false keeps compatibility with the old synchronous BE.
ANALYSIS_ASYNC_DELIVERY=true
ANALYSIS_CONCURRENCY=1
# Actual AI calls across BE processes, and independent sessions within one request.
# Supported range: 1..32. Calibrate before increasing; these are separate limits.
AI_CALL_CONCURRENCY=1
AI_SESSION_CONCURRENCY=1
ANALYSIS_FOREGROUND_BURST=5
ANALYSIS_QUEUE_MAX_BYTES=268435456
ANALYSIS_QUEUE_CHANNEL_BYTES=67108864
ANALYSIS_QUEUE_REQUEST_BYTES=262144
ANALYSIS_QUEUE_MAX_PENDING=2000
ANALYSIS_QUEUE_MIN_FREE_BYTES=67108864
BOT_JOURNAL_MAX_BYTES=268435456
BOT_SCAN_MAX_BYTES=67108864
ANALYSIS_COMPLETED_RETENTION_MS=604800000

# Discord user login (BE); register this exact FE callback in Discord OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3002/
# At least 32 random characters; shared across BE replicas, never sent to FE.
AUTH_SECRET=
# Optional FE build setting for a same-site BE origin; blank uses /api proxy.
VITE_API_ORIGIN=

# Shared secret for Bot internal monitoring reads (same value in BE and Bot)
BOT_SERVICE_TOKEN=

# Explicit frontend origins allowed to send credentialed browser requests
CORS_ORIGINS=http://localhost:5173,http://localhost:3002

# Why search uses real semantic embeddings independently of extraction provider.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY must be configured for both query and document embeddings.

# Browser links emitted by Discord commands
WEB_URL=http://localhost:3002
REVIEW_WEB_URL=http://localhost:3002
