{
  "name": "@ggaddak/be",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "swagger": "tsoa spec-and-routes --config tsoa.json",
    "build": "tsoa spec-and-routes --config tsoa.json && tsc",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "test": "vitest run",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:studio": "node scripts/prisma.mjs studio",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:baseline": "node scripts/prisma.mjs migrate resolve --applied 202610100001_legacy",
    "db:inspect": "python3 scripts/legacy-database.py inspect decisions.sqlite prisma/decisions.sqlite",
    "db:check": "node scripts/database.mjs check",
    "db:backup": "node scripts/database.mjs backup",
    "db:upgrade": "node scripts/database.mjs upgrade",
    "db:backfill": "node scripts/database.mjs backfill",
    "db:audit": "node dist/scripts/storage-audit.js",
    "search:backfill": "node dist/scripts/search-backfill.js",
    "ai:evaluate": "node dist/evaluation/runner.js",
    "ai:smoke": "node dist/evaluation/runner.js --live --smoke",
    "ai:benchmark": "node dist/evaluation/concurrency-benchmark.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "^0.0.15",
    "@ggaddak/shared": "*",
    "@prisma/client": "^5.22.0",
    "ai": "^3.1.10",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "morgan": "^1.10.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typedi": "^0.10.0",
    "winston": "^3.19.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^5.22.0",
    "tsoa": "^7.0.0-alpha.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
