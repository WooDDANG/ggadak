{
  "entryFile": "src/index.ts",
  "noImplicitAdditionalProperties": "silently-remove-extras",
  "controllerPathGlobs": [
    "src/api/controllers/**/*.controller.ts"
  ],
  "routes": {
    "routesDir": "src/api/routes/generated",
    "iocModule": "src/loaders/ioc.ts",
    "middleware": "express",
    "esm": true,
    "authenticationModule": "src/api/authentication.ts"
  },
  "spec": {
    "outputDirectory": "src/api/docs",
    "specVersion": 3,
    "info": {
      "title": "GGADDAK Decision Tracking Backend API",
      "version": "1.0.0",
      "description": "Discord Governance & Decision Tracking API with AI Extraction"
    },
    "securityDefinitions": {
      "jwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
