datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Decision {
  embedding DecisionEmbedding?
  id              String   @id
  domainJson      String?
  lifecycle       String @default("IN_REVIEW")
  category        String @default("기타")
  topic           String @default("")
  version         Int      @default(1)
  guildId         String
  channelId       String
  messageId       String
  title           String
  decisionSummary String
  keyReason       String
  status          String   @default("proposed") // "proposed" | "confirmed" | "rejected"
  decisionMaker   String
  participants    String   // JSON string array
  alternatives    String   // JSON string array
  tags            String   // JSON string array
  supersedesId    String?
  supersededById  String?
  sourceJumpUrl   String
  evidenceSummary String
  evidenceHash    String
  governanceScore Float
  governanceReason String
  governancePassed Boolean
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  archivedAt      DateTime?

  @@index([guildId, channelId])
  @@index([status])
  @@index([guildId, lifecycle, category, createdAt])
  @@index([supersedesId])
}

model ExternalFeedback {
  id           String   @id
  domainJson   String?
  channelId    String?
  decisionId   String
  source       String   // "slack" | "jira" | "github" | "manual"
  author       String
  content      String
  externalUrl  String?
  createdAt    DateTime @default(now())

  @@index([decisionId])
}

model ChannelCheckpoint {
  channelId     String   @id
  lastMessageId String
  updatedAt     DateTime @default(now())
}

model RejectedEvidenceHash {
  evidenceHash String   @id
  reason       String
  createdAt    DateTime @default(now())
}

model AnalysisRequest {
  id String @id
  fingerprint String
  guildId String
  channelId String
  manual Boolean
  state String
  owner String?
  leaseUntil DateTime?
  resultJson String?
  createdAt DateTime @default(now())
  completedAt DateTime?
}

model CandidateIdentity {
  key String @id
  decisionId String
  guildId String
  channelId String
  evidenceJson String
  normalizedContent String
  @@index([decisionId])
  @@index([guildId, channelId])
}

model CandidateAnalysis {
  requestId String
  decisionId String
  relatedJson String
  previousRequestsJson String
  @@id([requestId, decisionId])
  @@index([decisionId])
}

model User {
  id String @id
  username String
  avatar String?
  memberships Membership[]
  sessions AuthSession[]
  createdAt DateTime @default(now())
}

model Guild {
  channels MonitoredChannel[]
  id String @id
  name String
  icon String?
  memberships Membership[]
}

model Membership {
  userId String
  guildId String
  owner Boolean @default(false)
  permissions String @default("0")
  refreshedAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  @@id([userId, guildId])
}

model AuthSession {
  id String @id
  userId String
  refreshToken String
  expiresAt DateTime
  refreshedAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model OAuthState {
  nonce String @id
  expiresAt DateTime
}

model DecisionEdit {
 id String @id
 decisionId String
 actorId String
 version Int
 beforeJson String
 createdAt DateTime @default(now())
 @@unique([decisionId, version])
}

model MonitoredChannel {
  id String @id
  guildId String
  name String
  updatedAt DateTime @updatedAt
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  @@index([guildId])
}

model SyncJob {
  id String @id
  guildId String
  forceFullSync Boolean @default(false)
  status String @default("QUEUED")
  channelIdsJson String
  totalChannels Int @default(0)
  completedChannels Int @default(0)
  failedChannels Int @default(0)
  decisionsFound Int @default(0)
  messagesScanned Int @default(0)
  errorMessage String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  startedAt DateTime?
  completedAt DateTime?
  @@index([guildId, createdAt])
  @@index([status, leaseUntil])
}

model SyncJobLock {
  guildId String @id
  jobId String @unique
}

model DecisionEmbedding {
  decisionId String @id
  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  model String
  contentHash String
  vectorJson String
  updatedAt DateTime @updatedAt
}
